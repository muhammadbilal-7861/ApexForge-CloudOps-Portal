FLASK_ENV=development
# Public examples are development-only. Generate a private value before cloud use.
SECRET_KEY=development-only-not-for-cloud-signing-key
SESSION_COOKIE_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloudops
DB_USER=cloudops
DB_PASSWORD=development-only-db-password
DB_ROOT_PASSWORD=development-only-root-password
USE_AWS_SECRETS=false
AWS_SECRET_NAME=
AWS_REGION=
S3_BUCKET_NAME=
ENABLE_LAB_FAILURE_ENDPOINTS=false
APP_VERSION=1.0.0

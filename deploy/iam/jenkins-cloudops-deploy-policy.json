{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyReviewedPublicCanonicalImage",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-north-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "eu-north-1"}}
    },
    {
      "Sid": "ReadOnlyDeploymentDiscovery",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "autoscaling:DescribeInstanceRefreshes",
        "autoscaling:DescribeScalingActivities",
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeImages",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeRules",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "rds:DescribeDBInstances",
        "logs:DescribeLogGroups",
        "ssm:DescribeInstanceInformation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCloudOpsEcrImageMetadata",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": "arn:aws:ecr:eu-north-1:489502663059:repository/apexforge-cloudops-portal"
    },
    {
      "Sid": "ValidateCloudOpsDatabaseSecretShape",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-north-1:489502663059:secret:cloudops/prod/mariadb-*"
    },
    {
      "Sid": "CreateNumericCloudOpsLaunchTemplateVersion",
      "Effect": "Allow",
      "Action": "ec2:CreateLaunchTemplateVersion",
      "Resource": "arn:aws:ec2:eu-north-1:489502663059:launch-template/lt-028eb222c6fcfffc1"
    },
    {
      "Sid": "LaunchOnlyReviewedCloudOpsResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:eu-north-1::image/ami-0769f265f707fecc8",
        "arn:aws:ec2:eu-north-1:489502663059:subnet/subnet-08469c4e69b5c4d65",
        "arn:aws:ec2:eu-north-1:489502663059:subnet/subnet-05788ba98ca1096e6",
        "arn:aws:ec2:eu-north-1:489502663059:security-group/sg-0f9613afd389c288d",
        "arn:aws:ec2:eu-north-1:489502663059:launch-template/lt-028eb222c6fcfffc1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-north-1:489502663059:launch-template/lt-028eb222c6fcfffc1"
        }
      }
    },
    {
      "Sid": "LaunchOnlyTaggedT3MicroWithImdsv2",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:eu-north-1:489502663059:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-north-1:489502663059:launch-template/lt-028eb222c6fcfffc1",
          "ec2:InstanceType": "t3.micro",
          "ec2:MetadataHttpTokens": "required",
          "aws:RequestTag/Role": "app"
        }
      }
    },
    {
      "Sid": "LaunchCloudOpsGeneratedVolumesAndInterfaces",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:eu-north-1:489502663059:volume/*",
        "arn:aws:ec2:eu-north-1:489502663059:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-north-1:489502663059:launch-template/lt-028eb222c6fcfffc1"
        }
      }
    },
    {
      "Sid": "TagOnlyCloudOpsResourcesDuringLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:eu-north-1:489502663059:instance/*",
        "arn:aws:ec2:eu-north-1:489502663059:volume/*"
      ],
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "eu-north-1", "ec2:CreateAction": "RunInstances"},
        "ForAllValues:StringEquals": {"aws:TagKeys": ["Role", "Monitoring", "Version", "Environment", "Name", "Project", "aws:autoscaling:groupName"]}
      }
    },
    {
      "Sid": "PassOnlyCloudOpsAppRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::489502663059:role/CloudOpsEC2Role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "UpdateAndRefreshOnlyCloudOpsAsg",
      "Effect": "Allow",
      "Action": [
        "autoscaling:UpdateAutoScalingGroup",
        "autoscaling:StartInstanceRefresh",
        "autoscaling:CancelInstanceRefresh"
      ],
      "Resource": "arn:aws:autoscaling:eu-north-1:489502663059:autoScalingGroup:*:autoScalingGroupName/asg-cloudops-app"
    },
    {
      "Sid": "SendCommandsToApprovedCanary",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:eu-north-1::document/AWS-RunShellScript",
        "arn:aws:ec2:eu-north-1:489502663059:instance/i-02777a62f2a65bc1e"
      ]
    },
    {
      "Sid": "SendCommandsToTaggedCloudOpsFleet",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:eu-north-1:489502663059:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Role": "app"
        }
      }
    },
    {
      "Sid": "ReadOnlySsmCommandOutput",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}

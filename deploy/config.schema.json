{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apexforge360/deployment.schema.json",
  "title": "ApexForge360 reviewed non-secret deployment inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ALB_NAME",
    "APP_ROLE_NAME",
    "APP_SECURITY_GROUP_ID",
    "AWS_ACCOUNT_ID",
    "AWS_REGION",
    "AWS_ROLE_NAME",
    "CANARY_INSTANCE_ID",
    "DB_SECRET_NAME",
    "ECR_REPOSITORY",
    "INSTANCE_PROFILE_ARN",
    "LEGACY_CONTAINER_NAME",
    "LEGACY_IMAGE",
    "LOG_GROUP_NAME",
    "OBSERVABILITY_INSTANCE_ID",
    "PRIVATE_SUBNET_IDS",
    "RDS_INSTANCE_ID",
    "SESSION_COOKIE_SECURE",
    "SESSION_SECRET_NAME",
    "SOURCE_REPOSITORY",
    "TARGET_GROUP_ARN",
    "TARGET_GROUP_NAME",
    "VPC_ID",
    "example_only",
    "INSTANCE_PROFILE_NAME",
    "ALLOW_INITIAL_INSTALL"
  ],
  "properties": {
    "AWS_ACCOUNT_ID": {
      "type": "string",
      "pattern": "^(?:[0-9]{12})$"
    },
    "AWS_REGION": {
      "type": "string",
      "pattern": "^(?:[a-z]{2}-[a-z]+-[0-9])$"
    },
    "AWS_ROLE_NAME": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+=,.@_-]{1,64})$"
    },
    "APP_ROLE_NAME": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+=,.@_-]{1,64})$"
    },
    "ECR_REPOSITORY": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:[._/-][a-z0-9]+)*)$"
    },
    "VPC_ID": {
      "type": "string",
      "pattern": "^(?:vpc-[0-9a-f]{17})$"
    },
    "APP_SECURITY_GROUP_ID": {
      "type": "string",
      "pattern": "^(?:sg-[0-9a-f]{17})$"
    },
    "CANARY_INSTANCE_ID": {
      "type": "string",
      "pattern": "^(?:i-[0-9a-f]{17})$"
    },
    "OBSERVABILITY_INSTANCE_ID": {
      "type": "string",
      "pattern": "^(?:i-[0-9a-f]{17})$"
    },
    "SOURCE_REPOSITORY": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$"
    },
    "SESSION_COOKIE_SECURE": {
      "type": "string",
      "pattern": "^(?:true|false)$"
    },
    "LEGACY_CONTAINER_NAME": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})$"
    },
    "LEGACY_IMAGE": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_./:-]+)$"
    },
    "TARGET_GROUP_NAME": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,128}$"
    },
    "ALB_NAME": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,128}$"
    },
    "RDS_INSTANCE_ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,128}$"
    },
    "DB_SECRET_NAME": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,128}$"
    },
    "SESSION_SECRET_NAME": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,128}$"
    },
    "LOG_GROUP_NAME": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,128}$"
    },
    "example_only": {
      "type": "boolean"
    },
    "INSTANCE_PROFILE_ARN": {
      "type": "string"
    },
    "TARGET_GROUP_ARN": {
      "type": "string"
    },
    "PRIVATE_SUBNET_IDS": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^subnet-[0-9a-f]{17}$"
      }
    },
    "INSTANCE_PROFILE_NAME": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+=,.@_-]{1,64}$"
    },
    "ALLOW_INITIAL_INSTALL": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ]
    }
  }
}
